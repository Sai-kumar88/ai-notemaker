# NVIDIA API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEMPERATURE=0.35
NVIDIA_MAX_TOKENS=4096
NVIDIA_TIMEOUT_SECONDS=60.0
NVIDIA_MAX_RETRIES=3
NVIDIA_RETRY_DELAY_SECONDS=1.5
NVIDIA_MAX_CONNECTIONS=100
NVIDIA_MAX_KEEPALIVE_CONNECTIONS=20

# Document & Processing Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_BUFFER_BYTES=1048576
CHUNK_SIZE_CHARS=48000
CHUNK_OVERLAP_CHARS=1000
CHUNK_MIN_BOUNDARY_RATIO=0.4
CHUNK_SUMMARY_MAX_TOKENS=1200
MAX_CHUNKS=30
MAX_CONCURRENT_CHUNK_REQUESTS=8
ALLOWED_EXTENSIONS=[".pdf", ".docx"]
UPLOAD_DIR=uploads

# Application & Server Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=8052
CORS_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# Reverse-Proxy / Subpath Deployment
# ---------------------------------------------------------------------------
# URL prefix when mounted under a path on your reverse proxy.
# Examples:
#   APPLICATION_ROOT=/note-marker        → served at https://host/note-marker/
#   APPLICATION_ROOT=https://example.com:8052/note-marker/  → auto-extracts /note-marker
#   APPLICATION_ROOT=                    → served at domain root https://host/
APPLICATION_ROOT=/note-marker

# Alternatively use URL_PREFIX (same effect as APPLICATION_ROOT):
# URL_PREFIX=/note-marker

# Canonical public origin (protocol + host + optional port).
# Used to build absolute URLs in redirects when behind a reverse proxy.
# Leave blank to use the request's Host header.
# PUBLIC_ORIGIN=https://example.com:8052

# Number of reverse-proxy hops between Nginx and the container to trust
# for X-Forwarded-Proto / X-Forwarded-Host headers.
TRUSTED_PROXIES=1

# Number of uvicorn worker processes (production only; dev uses 1 with reload)
WORKERS=2
