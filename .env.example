# NVIDIA API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEMPERATURE=0.35
NVIDIA_MAX_TOKENS=4096
NVIDIA_TIMEOUT_SECONDS=60.0
NVIDIA_MAX_RETRIES=3
NVIDIA_RETRY_DELAY_SECONDS=1.5
NVIDIA_MAX_CONNECTIONS=100
NVIDIA_MAX_KEEPALIVE_CONNECTIONS=20

# Document & Processing Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_BUFFER_BYTES=1048576
CHUNK_SIZE_CHARS=12000
CHUNK_OVERLAP_CHARS=1000
CHUNK_MIN_BOUNDARY_RATIO=0.4
MAX_CHUNKS=30
MAX_CONCURRENT_CHUNK_REQUESTS=4
ALLOWED_EXTENSIONS=[".pdf", ".docx"]
UPLOAD_DIR=uploads

# Application & Server Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=5012
CORS_ORIGINS=["*"]
